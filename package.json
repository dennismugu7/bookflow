{
  "name": "bookflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bookflow — one backend serving a Flutter owner app and a client booking web app.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "workspaces": [
    "apps/api",
    "packages/contracts"
  ],
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit --project apps/api/tsconfig.json",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test": "npm run test:unit && npm run test:integration",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit",
    "verify": "npm run check && npm run test:integration",
    "dev": "npm run dev --workspace apps/api",
    "start": "npm run start --workspace apps/api",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate:new": "supabase migration new",
    "contracts:generate": "node scripts/generate-openapi.mjs && node scripts/generate-dart-client.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "db:types": "kysely-codegen --dialect postgres --include-pattern \"public.*\" --out-file apps/api/src/platform/db.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.2",
    "vitest": "^3.2.4"
  }
}
