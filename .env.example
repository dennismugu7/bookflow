# Bookflow — environment variables.
#
# ADR-023: this file is committed and lists every variable with its NAME and
# SHAPE and where to obtain it. It NEVER carries a value. `CLAUDE.md` §5 makes
# that a non-negotiable — a real value here is a committed credential.
#
# Copy to `.env` (gitignored) and fill in locally. No production credential is
# ever placed on a development machine; staging is the environment used for
# debugging (ADR-023).

# ─── API process ──────────────────────────────────────────────────────────────

# Port the Fastify service listens on. Integer. Defaults to 3000 if unset.
PORT=

# Interface to bind. Defaults to 0.0.0.0 if unset — required for container
# networking; use 127.0.0.1 to bind loopback only.
HOST=

# Which environment this process believes it is. One of: local | staging |
# production (ADR-023). Required; no default — set it explicitly.
#
# Deliberately APP_ENV and not NODE_ENV. NODE_ENV belongs to the JavaScript
# tooling, which writes to it unasked — Vitest forces it to `test`, bundlers
# force it to `production`. A test run silently reclassifying which environment
# the process thinks it is in is not a risk worth taking against ADR-023's
# separation of local, staging and production.
APP_ENV=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Local values come from `supabase start`, which prints all four on boot.
# Staging and production values come from the Supabase dashboard →
# Project Settings → API, and are held in Fly.io secrets and GitHub Actions
# encrypted secrets, never on a development machine (ADR-023).

# Project REST endpoint. URL, e.g. https://<project-ref>.supabase.co
# Local: http://127.0.0.1:54321
SUPABASE_URL=

# Publishable client key. Safe to expose; carries no privileges beyond RLS.
# Dashboard → Project Settings → API → Project API keys → anon/public.
# Local: `npm run db:start` prints this as ANON_KEY.
SUPABASE_ANON_KEY=

# Privileged server key. BYPASSES RLS ENTIRELY (spike 001/C7) — which is
# exactly why ADR-013 puts the membership scoping rule in the repository layer
# rather than trusting the database to catch it. API process only. Never sent
# to a client, never placed in the Flutter app, never logged.
# Dashboard → Project Settings → API → Project API keys → service_role.
# Local: `npm run db:start` prints this as SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# The two above are the legacy JWT-format keys. The CLI also prints a newer
# pair — PUBLISHABLE_KEY (`sb_publishable_…`) and SECRET_KEY (`sb_secret_…`) —
# which are the same two roles in Supabase's current key format. Nothing reads
# them yet: no Supabase client library is installed, and the API reaches
# Postgres directly through DATABASE_URL (ADR-013, ADR-022). Whichever pair the
# auth slice ends up using, it is chosen there and this file follows.

# The APPLICATION's connection, as the `bookflow_api` role (ADR-038): CRUD on
# the application tables, no DDL, no ownership. Read by
# apps/api/src/platform/db.ts. Nothing in the application connects as postgres,
# in any environment. Full URI:
#   postgresql://bookflow_api:<password>@<host>:<port>/<database>
# Local: the value below works as-is. The role's local password is set by
#        supabase/seed.sql, which is local-only, and is fixed and published
#        deliberately — it authenticates to a disposable container on
#        localhost, in the same class as the local anon key.
# Hosted: the password is generated at role-setup time and stored only in
#        GitHub Actions / Fly secrets. Never on a development machine (ADR-023).
DATABASE_URL=postgresql://bookflow_api:local_dev_password@127.0.0.1:54322/postgres

# A PRIVILEGED connection, as postgres. TOOLING ONLY — the integration test
# harness, which creates auth.users rows and switches roles, and
# `npm run db:types`, which introspects. The API never reads this, and a
# deployed API must not hold it: it is absent in staging and production by
# design.
# Local: `npm run db:start` prints it as "DB URL"; port 54322.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Not yet decided ──────────────────────────────────────────────────────────
# Listed rather than omitted, so that the first slice that needs one finds a
# named gap instead of an absence. Each is blocked on the triage item given.

# TODO(E1) — transactional email provider API key. Provider, sender identity
# and domain are unresolved; E1 in docs/analysis/05-triage.md is classified S
# and must be answered in the auth slice's Phase 0, before this is filled in.
# Shape unknown until the provider is chosen.
MAIL_PROVIDER_API_KEY=

# TODO(E1) — address transactional mail is sent from. Email address on a
# domain that is verified with the provider above.
MAIL_FROM_ADDRESS=

# TODO — public origin of the client booking web app, used to build the
# booking links carried in email (ADR-002, ADR-019). URL, no trailing slash.
# Unknowable until a domain exists; apps/web is not built yet (ADR-001).
PUBLIC_WEB_ORIGIN=
