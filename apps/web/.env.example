NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (public). Leave empty locally to use Cloudflare's test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server only. Never prefix these with NEXT_PUBLIC_.
# Supabase secret key (sb_secret_…): only the hold routes use it (ADR 0008).
SUPABASE_SECRET_KEY=
# Cloudflare Turnstile secret key. Leave empty locally to use Cloudflare's test keys.
TURNSTILE_SECRET_KEY=
