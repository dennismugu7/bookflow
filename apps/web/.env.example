NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (public). Leave empty locally to use Cloudflare's test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server only. Never prefix these with NEXT_PUBLIC_.
# Supabase secret key (sb_secret_…): only the hold routes (ADR 0008) and /api/account/delete use it.
SUPABASE_SECRET_KEY=
# Cloudflare Turnstile secret key. Leave empty locally to use Cloudflare's test keys.
TURNSTILE_SECRET_KEY=

# Google Play reviewer password for /api/review-sign-in (32+ random characters; Production only).
REVIEW_PASSWORD=
