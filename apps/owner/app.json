{
  "expo": {
    "name": "Bookflow Owner",
    "slug": "bookflow-owner",
    "owner": "mugulabs",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "platforms": ["android"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookflow",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.mugulabs.bookflow",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/78a8a0b2-77d1-48fe-8c16-2299fb26526c"
    },
    "extra": {
      "eas": {
        "projectId": "78a8a0b2-77d1-48fe-8c16-2299fb26526c"
      }
    }
  }
}
